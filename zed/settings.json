// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "format_on_save": "on",
  "tab_size": 2,
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "default_model": {
      "provider": "openai",
      "model": "gpt-5"
    },
    "model_parameters": []
  },
  "languages": {
    "TypeScript": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true
      },
      "formatter": []
    },
    "JavaScript": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true
      },
      "formatter": []
    }
  },
  "theme": {
    "mode": "system",
    "light": "Tokyo Night Light",
    "dark": "Tokyo Night"
  },
  "ui_font_size": 14,
  "buffer_font_size": 12,
  "terminal": {
    "shell": {
      "program": "nu"
    },
    "font_family": "MonaspiceNe Nerd Font",
    "font_features": {
      "calt": true,
      "liga": true,
      "dlig": true,
      "ss01": true,
      "ss02": true,
      "ss03": true,
      "ss04": true,
      "ss05": true,
      "ss06": true,
      "ss07": true,
      "ss08": true,
      "cv06": true,
      "cv12": true,
      "cv14": true,
      "cv16": true,
      "cv25": true,
      "cv26": true,
      "cv28": true,
      "cv29": true,
      "cv31": true,
      "cv32": true
    },
    "font_fallbacks": ["Apple Color Emoji", "Symbols Nerd Font"]
  },
  "ui_font_family": "MonaspiceNe Nerd Font",
  "ui_font_fallbacks": ["Apple Color Emoji", "Symbols Nerd Font"],
  "ui_font_features": {
    "calt": true,
    "liga": true,
    "dlig": true,
    "ss01": true,
    "ss02": true,
    "ss03": true,
    "ss04": true,
    "ss05": true,
    "ss06": true,
    "ss07": true,
    "ss08": true,
    "cv06": true,
    "cv12": true,
    "cv14": true,
    "cv16": true,
    "cv25": true,
    "cv26": true,
    "cv28": true,
    "cv29": true,
    "cv31": true,
    "cv32": true
  },
  "buffer_font_family": "MonaspiceNe Nerd Font",
  "buffer_font_features": {
    "calt": true,
    "liga": true,
    "dlig": true,
    "ss01": true,
    "ss02": true,
    "ss03": true,
    "ss04": true,
    "ss05": true,
    "ss06": true,
    "ss07": true,
    "ss08": true,
    "cv06": true,
    "cv12": true,
    "cv14": true,
    "cv16": true,
    "cv25": true,
    "cv26": true,
    "cv28": true,
    "cv29": true,
    "cv31": true,
    "cv32": true
  },
  "buffer_font_fallbacks": ["Apple Color Emoji", "Symbols Nerd Font"]
}
