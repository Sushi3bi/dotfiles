Include config.local
Include sites/*


Host *
  IgnoreUnknown UseKeychain
  UseKeychain yes
  AddKeysToAgent yes
  AddressFamily inet
  Compression yes
  IdentitiesOnly yes
  ServerAliveInterval 30
  ServerAliveCountMax 3
  ControlMaster auto
  ControlPath ~/.ssh/cm-%r@%h:%p
  ControlPersist 10m
  UpdateHostKeys yes
  StrictHostKeyChecking ask
  ForwardX11 no
  #KexAlgorithms curve25519-sha256@libssh.org
  #HostKeyAlgorithms ssh-ed25519
  # Leave ciphers/kex to OpenSSH defaults unless a host requires pinning.


Host steam-deck
  HostName 192.168.100.11
	User deck
	IdentityFile ~/.ssh/deck_ed25519
